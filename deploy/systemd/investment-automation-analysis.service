[Unit]
Description=Investment Automation - confirmation Telegram avant analyse high-cagr
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStartPre=@PROJECT_ROOT@/.venv/bin/python @PROJECT_ROOT@/scripts/update_deployment_code.py --project-root @PROJECT_ROOT@
ExecStart=@PROJECT_ROOT@/.venv/bin/python @PROJECT_ROOT@/scripts/request_telegram_analysis.py --mode high-cagr --timeout-seconds 43200
TimeoutStartSec=13h
