[Unit]
Description=Investment Automation - maintenance hebdomadaire conditionnelle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/investment_automation
ExecStart=/usr/bin/flock --exclusive --verbose %h/.local/state/investment_automation/operations.lock @PROJECT_ROOT@/.venv/bin/python @PROJECT_ROOT@/scripts/run_scheduled_maintenance.py --mode high-cagr --repair-safe --require-portfolio-sync
TimeoutStartSec=8h
